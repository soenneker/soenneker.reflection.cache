<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Ardalis.SmartEnum" Version="8.2.0" />
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
        <PackageReference Include="Intellenum" Version="2.0.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Soenneker.Tests.Attributes.Local" Version="11.0.154" />
        <PackageReference Include="Soenneker.Tests.Benchmark" Version="11.0.217" />
        <PackageReference Include="TUnit" Version="1.76.28" />
        <PackageReference Include="Serilog.Sinks.XUnit.Injectable" Version="11.0.297" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Reflection.Cache\Soenneker.Reflection.Cache.csproj" />
    </ItemGroup>
  <ItemGroup>
    <Compile Remove="Benchmarks\**\*.cs" />
    <Compile Remove="Benchmarking\**\*.cs" />
  </ItemGroup>
</Project>



